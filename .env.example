# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port
PORT=3000

# MongoDB Connection String (optional: if omitted, app uses built-in in-memory database)
MONGODB_URI="mongodb://localhost:27017/netflix_watch_spaces"

# JWT Secret for user session tokens
JWT_SECRET="netflix_ai_spaces_secret_jwt_key_2025"

